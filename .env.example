# Copy this file to .env and fill in real values. Never commit .env.

# --- LLM provider: pick one of anthropic | groq | gemini, then fill in ---
# --- that provider's key below. Groq and Gemini both offer free-tier keys. ---
LLM_PROVIDER=groq

ANTHROPIC_API_KEY=sk-ant-...
ANTHROPIC_MODEL=claude-sonnet-5

# Free key: https://console.groq.com/keys
GROQ_API_KEY=gsk_...
GROQ_MODEL=llama-3.3-70b-versatile

# Free key: https://aistudio.google.com/apikey
GEMINI_API_KEY=AIza...
GEMINI_MODEL=gemini-2.0-flash

# --- LangSmith tracing (optional but recommended, see README) ---
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=incident-investigation-agent

# --- App ---
ENVIRONMENT=development
LOG_LEVEL=INFO
